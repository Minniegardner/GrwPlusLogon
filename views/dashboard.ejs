<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111827" />
    <title>GTopia Player Support</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <style>
      :root { color-scheme: light; --ink: #172033; --muted: #718096; --line: #e5e9f0; --accent: #2d9cdb; --accent-dark: #237fb2; --surface: #fff; --page: #f3f6fa; }
      * { box-sizing: border-box; }
      html, body { min-height: 100%; }
      body { margin: 0; display: grid; place-items: center; padding: 24px 16px; background: radial-gradient(circle at 10% 0%, rgba(45,156,219,.14), transparent 34%), linear-gradient(145deg, var(--page), #eef2f7); color: var(--ink); font: 400 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      .login-shell { width: min(100%, 470px); animation: enter .35s ease-out both; }
      .login-card { overflow: hidden; border: 1px solid rgba(255,255,255,.85); border-radius: 18px; background: var(--surface); box-shadow: 0 18px 55px rgba(23,32,51,.12); }
      .card-header { padding: 32px 32px 25px; text-align: center; background: linear-gradient(140deg, #172033, #253653); color: #fff; }
      .brand-mark { display: inline-grid; width: 46px; height: 46px; place-items: center; margin-bottom: 12px; border-radius: 13px; background: linear-gradient(145deg, #55c5f5, var(--accent)); box-shadow: 0 8px 18px rgba(45,156,219,.28); font-size: 21px; font-weight: 800; }
      h1 { margin: 0; font-size: 23px; letter-spacing: -.3px; }
      .subtitle { margin: 7px 0 0; color: #cbd7e8; font-size: 13px; }
      .card-body { padding: 28px 32px 30px; }
      .form-group { margin-bottom: 16px; }
      label { display: block; margin: 0 0 7px; color: #44516a; font-size: 13px; font-weight: 650; }
      .form-control { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 12px 13px; outline: 0; background: #fbfcfe; color: var(--ink); font: inherit; transition: border-color .2s, box-shadow .2s, background .2s; }
      .form-control::placeholder { color: #9aa6b8; }
      .form-control:focus { border-color: var(--accent); background: #fff; box-shadow: 0 0 0 4px rgba(45,156,219,.12); }
      .grow-button { width: 100%; border: 0; border-radius: 10px; padding: 12px 18px; background: var(--accent); color: #fff; cursor: pointer; font: inherit; font-weight: 700; transition: background .2s, transform .2s, box-shadow .2s; }
      .grow-button:hover { background: var(--accent-dark); box-shadow: 0 7px 16px rgba(45,156,219,.24); }
      .grow-button:active { transform: translateY(1px); }
      .switch-copy { margin: 19px 0 0; text-align: center; color: var(--muted); font-size: 13px; }
      .switch-copy a { color: var(--accent-dark); font-weight: 700; text-decoration: none; }
      .switch-copy a:hover { text-decoration: underline; }
      .helper { margin: 5px 0 0; text-align: center; color: #9aa6b8; font-size: 12px; }
      .register-container { margin-top: 23px; padding-top: 23px; border-top: 1px solid var(--line); }
      .register-title { margin: 0 0 16px; color: var(--ink); font-size: 15px; font-weight: 700; }
      .hidden { display: none; }
      @keyframes enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @media (max-width: 480px) { body { padding: 12px; } .card-header, .card-body { padding-left: 22px; padding-right: 22px; } }
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card" aria-labelledby="page-title">
        <header class="card-header">
          <div class="brand-mark" aria-hidden="true">G</div>
          <h1 id="page-title">Log in with your GTopiaID</h1>
          <p class="subtitle">Access your account to continue playing.</p>
        </header>
        <div class="card-body">
          <form method="POST" action="/player/growid/login/validate" autocomplete="off">
            <input name="_token" type="hidden" value="<%= token %>" />
            <div class="form-group">
              <label for="login-name">GTopiaID name</label>
              <input id="login-name" class="form-control" placeholder="Enter your GTopiaID" name="growId" type="text" minlength="3" maxlength="20" required />
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input id="password" class="form-control" placeholder="Enter your password" name="password" type="password" minlength="4" maxlength="25" required />
            </div>
            <button class="grow-button" type="submit">Log in</button>
          </form>
          <p class="switch-copy">Don't have an account? <a href="#" id="createGrowid">Create a GTopiaID</a></p>
          <p class="helper">New players must register through this page before playing.</p>
          <div id="registerContainer" class="register-container hidden">
            <p class="register-title">Create your GTopiaID</p>
            <form method="POST" action="/player/growid/login/validate" autocomplete="off">
              <input name="_token" type="hidden" value="<%= token %>" />
              <div class="form-group">
                <label for="reg-growid">GTopiaID name</label>
                <input id="reg-growid" class="form-control" placeholder="Choose a GTopiaID" name="growId" type="text" minlength="3" maxlength="20" required />
              </div>
              <div class="form-group">
                <label for="reg-password">Password</label>
                <input id="reg-password" class="form-control" placeholder="Create a password" name="password" type="password" minlength="4" maxlength="25" required />
              </div>
              <div class="form-group">
                <label for="reg-email">Email address</label>
                <input id="reg-email" class="form-control" placeholder="For password recovery" name="email" type="email" required />
              </div>
              <button class="grow-button" type="submit">Create GTopiaID</button>
            </form>
          </div>
        </div>
      </section>
    </main>
    <script>
      const registerLink = document.getElementById("createGrowid");
      const registerContainer = document.getElementById("registerContainer");
      const loginForm = document.querySelector(".card-body > form");
      let registerMode = false;
      registerLink.addEventListener("click", (event) => {
        event.preventDefault();
        registerMode = !registerMode;
        registerContainer.classList.toggle("hidden", !registerMode);
        loginForm.classList.toggle("hidden", registerMode);
        registerLink.textContent = registerMode ? "Back to login" : "Create a GTopiaID";
        document.getElementById("page-title").textContent = registerMode ? "Create your GTopiaID" : "Log in with your GTopiaID";
        if (registerMode) document.getElementById("reg-growid").focus();
      });
    </script>
  </body>
</html>
